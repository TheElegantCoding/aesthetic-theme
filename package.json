{
  "name": "aesthetic-theme",
  "displayName": "Aesthetic's Theme",
  "description": "My personal color schema themes for vscode",
  "author": "Luis Monsalve",
  "version": "0.0.1",
  "private": true,
  "keywords": [
    "vscode",
    "vscode-extension",
    "theme",
    "visual-studio-code",
    "vsc-theme"
  ],
  "categories": ["Themes"],
  "type": "module",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "contributes": {
    "themes": [{
      "label": "Aesthetic's Theme",
      "uiTheme": "vs-dark",
      "path": "./dist/aesthetic_dark_theme.json"
    }]
  },
  "scripts": {
    "postinstall": "bunx gitlys init",
    "preinstall": "npx only-allow bun",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && bunx gitlys release",
    "lint": "eslint --fix",
    "build:theme": "bun src/global/util/generate_theme.ts",
    "watch": "bun --hot src/global/util/generate_theme.ts",
    "build": "tsup src/index.ts --format cjs --external vscode && npm run build:theme",
    "package": "vsce package --no-dependencies",
    "publish": "vsxpub --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "eslint-config-universal-code": "1.1.1",
    "gitlys": "2.2.1",
    "tsup": "8.5.1",
    "typescript": "5.2.2"
  }
}